---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import InvestorForm from '../components/InvestorForm.astro';
import { SITE } from '../site.config';
---

<BaseLayout
  title="Contact"
  description="Get in touch with GuestGuideIQ — join the waitlist, apply as a partner, or reach out as an investor or press."
>
  <section class="wrap section">
    <span class="eyebrow">Get in touch</span>
    <h1>Three quick ways to reach us.</h1>
    <p class="lead">
      Pick the one that fits — or just email us directly at{' '}
      <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
    </p>
  </section>

  <section class="wrap section-tight contact-grid">
    <div class="card contact-card">
      <span class="eyebrow">Traveler</span>
      <h2>Join the waitlist</h2>
      <p class="muted">
        We’ll email you the moment GuestGuideIQ launches — no spam, just the launch and a first
        look at real hidden gems.
      </p>
      <WaitlistForm id="waitlist-contact" compact />
    </div>

    <div class="card contact-card">
      <span class="eyebrow">STR operator / experience provider / DMO</span>
      <h2>Apply as a partner</h2>
      <p class="muted">
        Whether you’re a short-term rental operator, an experience provider, or a destination
        organization, the full partner form covers all three and routes to the right
        conversation.
      </p>
      <a class="btn btn-primary" href="/partners/#apply">Go to the partner form</a>
    </div>

    <div class="card contact-card contact-card-wide">
      <span class="eyebrow">Investor / press</span>
      <h2>Request more info</h2>
      <p class="muted">
        Want the fuller story, our roadmap, or just to ask a question directly? Tell us a bit
        about yourself below.
      </p>
      <InvestorForm id="investor-contact" />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .contact-card {
    padding: clamp(24px, 4vw, 32px);
  }

  .contact-card h2 {
    margin-top: 4px;
    margin-bottom: 6px;
  }

  .contact-card-wide {
    grid-column: 1 / -1;
  }
</style>
