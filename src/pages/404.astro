---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page doesn't exist on GuestGuideIQ.">
  <section class="wrap section not-found">
    <span class="eyebrow mono">404</span>
    <h1>This spot isn’t on the map.</h1>
    <p class="lead">
      Even the best local guide has streets it hasn’t covered yet. Let’s get you back to one that
      is.
    </p>
    <a class="btn btn-primary" href="/">Back to home</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }

  .not-found .lead {
    margin-left: auto;
    margin-right: auto;
  }

  .not-found .btn {
    margin-top: 8px;
  }
</style>
