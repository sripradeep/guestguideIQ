---
import { FORMS, SITE } from '../site.config';

interface Props {
  id?: string;
  compact?: boolean;
}

const { id = 'waitlist', compact = false } = Astro.props;
// Formspree's _next redirect requires a fully-qualified URL — a relative
// path like "/thank-you/" is silently ignored and it falls back to its own
// generic success page.
const thankYouUrl = new URL('/thank-you/', SITE.url).toString();
---

<div class:list={['waitlist-form', { compact }]} id={id}>
  {!compact && (
    <>
      <h2>Be first to know when we launch</h2>
      <p class="lead">
        Join the waitlist and we’ll email you the moment GuestGuideIQ is ready — plus the first
        look at real hidden gems near you.
      </p>
    </>
  )}
  <form
    action={FORMS.waitlist}
    method="POST"
    class="inline-form"
    data-ajax-form
    data-success-url="/thank-you/"
  >
    <input type="hidden" name="_subject" value="New GuestGuideIQ waitlist signup" />
    <input type="hidden" name="_next" value={thankYouUrl} />
    <label class="sr-only" for={`${id}-email`}>Email address</label>
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      placeholder="you@email.com"
      autocomplete="email"
    />
    <button class="btn btn-primary" type="submit">Join the Waitlist</button>
  </form>
  <p class="form-note">We’ll only email you about GuestGuideIQ’s launch. No spam, unsubscribe anytime.</p>
  <p class="form-error" data-form-error hidden>
    Something went wrong sending that — please try again, or email us at hello@guestguideiq.com.
  </p>
</div>

<style>
  .waitlist-form h2 {
    margin-bottom: 10px;
  }

  .inline-form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 18px;
  }

  .compact .inline-form {
    margin-top: 0;
  }

  .inline-form input[type='email'] {
    flex: 1 1 260px;
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 12px 16px;
    border-radius: 100px;
    border: 1px solid var(--line);
    background: var(--surface-raised);
    color: var(--ink);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
