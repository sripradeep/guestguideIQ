# Copy this file to .env (or .env.production for a production build) and
# fill in real values. .env* files are gitignored — see README.md "Forms".

# Base URL of the GuestGuideIQ backend's lead-capture API, e.g.
# https://api.guestguideiq.com. Used by the waitlist/partner/investor forms
# (src/site.config.ts). If unset, requests fall back to a local dev
# placeholder and will simply fail unless a backend is running there.
PUBLIC_API_BASE_URL=https://api.guestguideiq.com
